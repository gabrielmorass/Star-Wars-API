# Variáveis de ambiente — Codex Estelar · Projeto S07 NP2
# ============================================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA. O .env NUNCA é commitado.
#
#     cp .env.example .env
#
# Este arquivo (sem segredos) É versionado de propósito: ele documenta o
# contrato de configuração do projeto. É também a evidência do critério 5 —
# "e-mail não hardcoded, configurado via variável de ambiente".
#
# Cada bloco abaixo tem um dono. Precisa acrescentar variável? Acrescente no
# seu bloco e avise no grupo, porque o arquivo é usado pelos cinco.

# ----------------------------------------------------------------------------
# Jenkins — Gabriel (Bloco A)
# ----------------------------------------------------------------------------
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=troque-esta-senha
JENKINS_URL=http://localhost:8081/

# Repositório que o job do pipeline clona.
REPO_URL=https://github.com/gabrielmorass/Star-Wars-API.git
REPO_BRANCH=main

# GID do grupo dono de /var/run/docker.sock NO HOST.
# Linux/WSL:  stat -c '%g' /var/run/docker.sock
# Docker Desktop (Windows/macOS): normalmente 0 — ver jenkins/README.md.
DOCKER_GID=999

# ----------------------------------------------------------------------------
# Notificação por e-mail — Lima (Bloco E) · CRITÉRIO 5
# ----------------------------------------------------------------------------
# Para onde o pipeline avisa o resultado da execução. É ESTA variável que
# prova o critério: trocar o valor aqui muda o destinatário sem tocar em
# nenhuma linha de código.
EMAIL_DESTINATARIO=

# Remetente exibido na mensagem.
EMAIL_REMETENTE=    

# Servidor SMTP. Com Gmail, SMTP_PASS é uma "senha de app", não a senha da
# conta — e a verificação em duas etapas precisa estar ligada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=

# ----------------------------------------------------------------------------
# Docker Hub — Lima (Bloco E) · CRITÉRIO 6
# ----------------------------------------------------------------------------
# O token é gerado em hub.docker.com → Account Settings → Personal access
# tokens. Nunca usar a senha da conta.
#
# DOCKERHUB_USER é o dono da imagem, e vale para o pipeline E para o compose:
#   - o Jenkinsfile deriva dele IMAGE_REPO (<user>/codex-estelar-api);
#   - o serviço api do compose monta o nome da imagem com ele.
# SEM HÍFEN: o Docker Hub não aceita hífen em nome de usuário ou organização.
# Vazio, tudo cai no padrão "codexestelar".
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# ----------------------------------------------------------------------------
# Docker Compose — portas e tag da imagem
# ----------------------------------------------------------------------------
# Lidas SÓ pelo compose, todas com padrão. Só mexa se a porta estiver ocupada
# na sua máquina ou se quiser subir uma tag específica da api.
#
# API_TAG escolhe qual tag da imagem da api o compose sobe. O imagem.sh gera
# duas tags por build (número do build e sha curto do commit) e recusa
# "latest" de propósito, então para subir o que o pipeline acabou de
# construir use o sha: API_TAG=<sha curto>. O estágio Smoke test do
# Jenkinsfile já faz isso sozinho.
API_TAG=latest
WEB_PORT=8080
API_PORT=3000

# ----------------------------------------------------------------------------
# BFF (api) — Eduardo (Bloco B) e Samile (Bloco D)
# ----------------------------------------------------------------------------
PORT=3000
SWAPI_BASE_URL=https://swapi.info/api
REDIS_URL=redis://redis:6379
CACHE_TTL_SEGUNDOS=3600
