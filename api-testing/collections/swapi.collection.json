                "people"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Luke"
                }
              ]
            },
            "description": "A SWAPI não implementa busca server-side (documentado no README do projeto) — espera-se que o parâmetro seja ignorado e a lista completa seja retornada, não uma lista filtrada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200 OK mesmo com parâmetro ignorado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Parâmetro search é ignorado — retorna a lista completa, não filtrada', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(resposta.length).to.be.above(1);",
                  "});"
                ]
              }
            }
