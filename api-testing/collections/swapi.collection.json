{
  "info": {
    "name": "SWAPI — Codex Estelar",
    "description": "Testes de API contra a SWAPI (https://swapi.info/api), a mesma consumida pelo front-end do Codex Estelar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Dados Válidos",
      "description": "Cenários com endpoints e parâmetros corretos — caminho feliz.",
      "item": [
        {
          "name": "TC-011 — GET /planets retorna lista válida",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/planets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "planets"
              ]
            },
            "description": "Lista todos os planetas — usada pelo carrossel do Sistema Planetário."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta deve ser uma lista não vazia', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(resposta).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Cada planeta deve ter name, climate e residents', function () {",
                  "    const resposta = pm.response.json();",
                  "    const primeiro = resposta[0];",
                  "    pm.expect(primeiro).to.have.property('name');",
                  "    pm.expect(primeiro).to.have.property('climate');",
                  "    pm.expect(primeiro).to.have.property('residents').that.is.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
