    {
      "name": "Dados Inválidos e Inoportunos",
      "description": "Cenários com IDs inexistentes, malformados ou parâmetros não suportados pela SWAPI.",
      "item": [
        {
          "name": "GET /planets/9999 — ID inexistente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/planets/9999",
              "host": ["{{baseUrl}}"],
              "path": ["planets", "9999"]
            },
            "description": "Não existe planeta com esse ID. A aplicação trata esse erro em fetchJSON (js/core/api.js), sem lançar exceção não capturada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /planets/abc — ID malformado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/planets/abc",
              "host": ["{{baseUrl}}"],
              "path": ["planets", "abc"]
            },
            "description": "ID não numérico — a API deve rejeitar o recurso em vez de retornar 200 com dado inválido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status não deve ser 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(200);",
                  "});"
                ]
              }
            }
          ]
        },
