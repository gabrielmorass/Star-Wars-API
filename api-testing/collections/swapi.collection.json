        {
          "name": "TC-087 — Integridade referencial entre planeta e residente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/planets/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "planets",
                "1"
              ]
            },
            "description": "Segue o primeiro link de residents de planets/1 e confirma que o personagem aponta de volta para o mesmo planeta — é o vínculo que o site usa para derivar as espécies do planeta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const planeta = pm.response.json();",
                  "",
                  "pm.test('O primeiro residente deve responder 200 e apontar de volta para o planeta', function (done) {",
                  "    pm.sendRequest(planeta.residents[0], function (erro, resposta) {",
                  "        if (erro) { return done(erro); }",
                  "        pm.expect(resposta.code).to.eql(200);",
                  "        pm.expect(resposta.json().homeworld).to.eql(planeta.url);",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
