            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Deve listar os seis recursos consumidos pelo site', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(Object.keys(resposta).sort()).to.eql([",
                  "        'films', 'people', 'planets', 'species', 'starships', 'vehicles',",
                  "    ]);",
                  "});",
                  "",
                  "pm.test('Cada recurso deve apontar para uma URL absoluta', function () {",
                  "    const resposta = pm.response.json();",
                  "    Object.values(resposta).forEach(function (url) {",
                  "        pm.expect(url).to.be.a('string').that.match(/^https?:\\/\\//);",
                  "    });",
                  "});"
