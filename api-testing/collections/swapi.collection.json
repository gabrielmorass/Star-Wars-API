                  "});",
                  "",
                  "pm.test('Cada personagem deve ter o campo birth_year', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(resposta[0]).to.have.property('birth_year');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /films retorna os 6 episódios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/films",
              "host": ["{{baseUrl}}"],
              "path": ["films"]
            },
            "description": "Lista todos os filmes — a SWAPI cobre os Episódios I a VI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status deve ser 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Deve retornar exatamente 6 filmes', function () {",
                  "    const resposta = pm.response.json();",
                  "    pm.expect(resposta).to.have.lengthOf(6);",
                  "});",
                  "",
                  "pm.test('episode_id deve cobrir de 1 a 6', function () {",
                  "    const resposta = pm.response.json();",
                  "    const episodios = resposta.map((f) => f.episode_id).sort((a, b) => a - b);",
                  "    pm.expect(episodios).to.eql([1, 2, 3, 4, 5, 6]);",
                  "});"
                ]
              }
            }
          ]
        },
