# Notas internas do grupo — acompanhamento de progresso e motivação dos
# testes. Não fazem parte da entrega em si (o Plano de Testes formal é
# entregue separadamente em PDF) e não devem ser versionados.
docs-local/

# Dependências instaladas (cypress-project/, api-testing/ e api/)
node_modules/

# --- NP2 / DevOps ---------------------------------------------------------
# Segredos: senha do Jenkins, token do Docker Hub, credenciais SMTP.
# O contrato de configuração fica em .env.example, que É versionado.
.env
.env.local
.env.*.local

# Cobertura e relatórios de teste do BFF: artefatos de execução, publicados
# como artefato no Jenkins (critério 4), não código-fonte.
api/coverage/
api/relatorios/

# Pacotes gerados pelo estágio de empacotamento do pipeline.
dist/
*.tgz

# Cache/artefatos de execução do Cypress
cypress-project/cypress/videos/
cypress-project/cypress/screenshots/
cypress-project/cypress/downloads/

# Relatórios de execução gerados pelos testes (HTML/JSON) — artefatos de
# cada execução, não código-fonte
cypress-project/relatorio/
cypress-project/cypress-mochawesome-reporter.log
api-testing/relatorio.html
performance-testing/relatorio/

# Página temporária de conferência da renderização procedural
debug-planets.html

# Specs de diagnóstico: servem para medir a interface durante o
# desenvolvimento (layout, contagens, animações) e não fazem parte da suíte
# entregue, que é a BDD em cypress/bdd/
cypress-project/cypress/diag/
cypress-project/cypress.diag.config.js

# Relatorios gerados pelo estagio de Testes de API no pipeline
api-testing/relatorios/
