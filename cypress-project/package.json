{
  "name": "cypress-codex-estelar",
  "version": "1.0.0",
  "description": "Testes de interface do Codex Estelar com Cypress — POM e BDD (Gherkin)",
  "author": "Codex Estelar QA",
  "license": "MIT",
  "scripts": {
    "cypress:abrir": "cypress open",
    "test": "start-server-and-test servidor http://localhost:8080 test:bdd",
    "test:bdd": "cypress run --config-file cypress.bdd.config.js",
    "abrir:bdd": "cypress open --config-file cypress.bdd.config.js",
    "servidor": "http-server .. -p 8080 -s"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.0.0",
    "cypress": "^16.1.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/bdd/step_definitions/**/*.steps.js"
  }
}
